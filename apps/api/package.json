{
  "name": "@turborepo-remote-cache/api",
  "version": "5.3.1",
  "private": true,
  "description": "The Turborepo remote cache server, for Cloudflare Workers, AWS Lambda, Vercel, Netlify, Node.js, Bun, and Deno",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "codegen": "wrangler types",
    "codegen:check": "wrangler types --check",
    "deploy": "wrangler deploy",
    "dev": "vite dev",
    "preview": "wrangler dev --port 8787 --var TURBO_TOKEN:test-token",
    "start": "node .output/server/index.mjs",
    "test": "vitest run --coverage",
    "test:e2e": "bash e2e/run.sh",
    "test:watch": "vitest",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@turborepo-remote-cache/files-sdk-kv": "workspace:*",
    "files-sdk": "catalog:",
    "nitro": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@turborepo-remote-cache/dashboard": "workspace:*",
    "@turborepo-remote-cache/spec": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "db0": "catalog:",
    "miniflare": "catalog:",
    "srvx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
