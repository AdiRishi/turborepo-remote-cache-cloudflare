{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "turborepo-remote-cache",
  "compatibility_date": "2026-06-15",
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    },
    "issues": {
      "enabled": true
    }
  },
  // Set the bearer token with `wrangler secret put TURBO_TOKEN`.
  "vars": {
    "BUCKET_OBJECT_EXPIRATION_HOURS": 720
  },
  "r2_buckets": [
    {
      "binding": "R2_STORE",
      "bucket_name": "turborepo-cache",
      "preview_bucket_name": "turborepo-cache-preview"
    }
  ],
  // Usage stats for the dashboard. Remove the binding to turn them off.
  "d1_databases": [
    {
      "binding": "STATS_DB",
      "database_name": "turborepo-cache-stats"
    }
  ]
  // Bind a KV namespace to store artifacts in KV instead. KV wins when both are bound.
  // "kv_namespaces": [{ "binding": "KV_STORE", "id": "<namespace id>" }]
}
