{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "env": ["NITRO_*", "SERVER_PRESET"],
      "outputs": [".output/**", ".wrangler/deploy/config.json"]
    },
    "test": {
      "env": ["CONTRACT_BASE_URL"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
