{
  "name": "@turborepo-remote-cache/server",
  "version": "4.0.0",
  "private": true,
  "description": "A Turborepo remote cache server for Cloudflare Workers and any Nitro deployment target",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "codegen": "pnpm codegen:spec && pnpm codegen:worker",
    "codegen:check": "pnpm codegen:spec && git diff --exit-code -- openapi && wrangler types --check",
    "codegen:spec": "pnpm --package=openapi-typescript@7.13.0 --package=typescript@5.9.3 dlx openapi-typescript openapi/turborepo.openapi.json --output openapi/turborepo.ts",
    "codegen:worker": "wrangler types",
    "deploy": "wrangler deploy",
    "dev": "vite dev",
    "preview": "wrangler dev --port 8787 --var TURBO_TOKEN:test-token",
    "spec:sync": "curl --fail --silent --show-error --location https://turborepo.com/api/remote-cache-spec --output openapi/turborepo.openapi.json && pnpm codegen:spec",
    "start": "node .output/server/index.mjs",
    "test": "vitest run --coverage",
    "test:e2e": "sh e2e/run.sh",
    "test:watch": "vitest",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@turborepo-remote-cache/files-sdk-kv": "workspace:*",
    "files-sdk": "3.1.1",
    "nitro": "3.0.260903-beta",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/coverage-istanbul": "^5.0.5",
    "miniflare": "5.20261012.1-beta",
    "srvx": "^1.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
