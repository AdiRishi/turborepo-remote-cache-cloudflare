{
  "name": "turborepo-remote-cache-cf",
  "version": "4.0.0",
  "private": true,
  "description": "A Cloudflare-first Turborepo remote cache that deploys anywhere with Nitro",
  "keywords": [
    "cloudflare-r2",
    "cloudflare-workers",
    "nitro",
    "remote-caching",
    "s3",
    "serverless",
    "turborepo",
    "vercel"
  ],
  "homepage": "https://github.com/AdiRishi/turborepo-remote-cache-cloudflare",
  "bugs": {
    "url": "https://github.com/AdiRishi/turborepo-remote-cache-cloudflare/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Adishwar Rishi",
    "email": "adiswa123@gmail.com",
    "url": "https://github.com/AdiRishi"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AdiRishi/turborepo-remote-cache-cloudflare.git"
  },
  "type": "module",
  "scripts": {
    "api:check": "node scripts/remote-cache-openapi.mjs check",
    "api:generate": "node scripts/remote-cache-openapi.mjs generate",
    "api:sync": "node scripts/remote-cache-openapi.mjs sync",
    "build": "nitro build",
    "build:node": "nitro build --preset node_server",
    "cf-typegen": "wrangler types --env-file .dev.vars.example",
    "deploy": "nitro deploy",
    "dev": "nitro dev",
    "docs:build": "vitepress build docs",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --quiet && oxfmt --check .",
    "lint:fix": "oxlint --fix",
    "preview": "nitro preview",
    "test": "vitest run --coverage",
    "test:turbo": "node tests/e2e/turbo-smoke.mjs",
    "test:ui": "vitest --coverage --ui",
    "test:watch": "vitest",
    "typecheck": "nitro prepare && tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1083.0",
    "@aws-sdk/lib-storage": "^3.1083.0",
    "@aws-sdk/s3-presigned-post": "^3.1083.0",
    "@aws-sdk/s3-request-presigner": "^3.1083.0",
    "@hono/valibot-validator": "^0.6.1",
    "files-sdk": "2.1.0",
    "hono": "^4.12.25",
    "valibot": "^1.4.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@cloudflare/vitest-pool-workers": "^0.18.3",
    "@types/node": "^26.1.1",
    "@vitest/coverage-istanbul": "^4.1.8",
    "@vitest/ui": "^4.1.8",
    "miniflare": "^4.20260708.0",
    "nitro": "3.0.260610-beta",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "oxlint-tsgolint": "^0.23.0",
    "turbo": "2.10.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitepress": "2.0.0-alpha.16",
    "vitest": "^4.1.8",
    "wrangler": "^4.109.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.6.0",
  "readme": "README.md"
}
