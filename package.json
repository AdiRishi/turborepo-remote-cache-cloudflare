{
  "name": "turborepo-remote-cache-cloudflare",
  "private": true,
  "description": "An implementation of the turborepo-remote-cache server custom made for Cloudflare Workers",
  "keywords": [
    "cloudflare-r2",
    "cloudflare-workers",
    "remote-caching",
    "serverless",
    "turborepo",
    "vercel"
  ],
  "homepage": "https://github.com/AdiRishi/turborepo-remote-cache-cloudflare",
  "bugs": {
    "url": "https://github.com/AdiRishi/turborepo-remote-cache-cloudflare/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Adishwar Rishi",
    "email": "adiswa123@gmail.com",
    "url": "https://github.com/AdiRishi"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AdiRishi/turborepo-remote-cache-cloudflare.git"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "docs": "turbo run build --filter=@turborepo-remote-cache/docs",
    "format": "oxfmt .",
    "lint": "oxlint --quiet && oxfmt --check .",
    "lint:fix": "oxlint --fix",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "oxlint-tsgolint": "^0.23.0",
    "turbo": "^2.11.9"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.6.0"
}
