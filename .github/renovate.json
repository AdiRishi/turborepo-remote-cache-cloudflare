{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabled": false,
  "extends": ["config:recommended", ":semanticCommitTypeAll(chore)"],
  "dependencyDashboard": true,
  "rangeStrategy": "bump",
  "minimumReleaseAge": "1 day",
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "dependencies (non-major)",
      "automerge": true,
      "schedule": ["* * * * 0,6"]
    },
    {
      "matchDepTypes": ["engines"],
      "enabled": false
    },
    {
      "groupName": "oxc",
      "matchPackageNames": ["oxlint", "oxfmt", "oxlint-tsgolint"]
    },
    {
      "groupName": "cloudflare",
      "matchPackageNames": ["wrangler", "miniflare", "@cloudflare/**"]
    },
    {
      "description": "Pre-stable betas: pin exact versions and review every update",
      "matchPackageNames": ["nitro", "files-sdk"],
      "rangeStrategy": "pin",
      "automerge": false
    }
  ]
}
