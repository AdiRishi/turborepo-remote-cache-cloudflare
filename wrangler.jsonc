{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "turborepo-remote-cache",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-08",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
  "vars": {
    // - TURBO_TOKEN (must be a valid Bearer auth token)
    // Run `echo <VALUE> | wrangler secret put <NAME>` for each of these
    "STORAGE_PROVIDER": "r2",
    "CACHE_RETENTION_HOURS": 720,
  },
  "r2_buckets": [
    {
      "binding": "R2_STORE",
      "bucket_name": "turborepo-cache",
      "preview_bucket_name": "turborepo-cache-preview",
    },
  ],
  // "kv_namespaces": [{"binding": "KV_STORE", "id": "ea20b0eb60f44b13b8d013eeace98ca2", "preview_id": "ea20b0eb60f44b13b8d013eeace98ca2"}],
  // Legacy direct-Wrangler deployments of src/index.ts still need this. Nitro
  // generates the same trigger from nitro.config.ts for the normal deploy path.
  "triggers": {
    "crons": ["0 3 * * *"],
  },
}
