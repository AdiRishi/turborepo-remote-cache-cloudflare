{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": [".nvmrc", "tsconfig.base.json"],
  "remoteCache": {
    "apiUrl": "https://turbo-cache.adishwar-rishi.com",
    "teamId": "team_turborepo-remote-cache-cloudflare",
    "signature": true
  },
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build", "transit"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "transit"]
    },
    "test": {
      "dependsOn": ["^build", "transit"],
      "outputs": ["coverage/**"],
      "passThroughEnv": ["CI"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "//#lint": {}
  }
}
